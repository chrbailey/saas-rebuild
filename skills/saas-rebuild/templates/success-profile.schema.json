{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/success-profile.schema.json",
  "title": "Locked pre-evidence success profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "teardown_id",
    "app",
    "created_at",
    "locked_at",
    "approved_by",
    "outcomes",
    "criteria",
    "non_goals",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "0.12.0"
    },
    "teardown_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "locked_at": {
      "$ref": "#/$defs/timestamp"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "non_goals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "budget",
              "deadline",
              "legal",
              "security",
              "operational",
              "technical"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "change_control": {
      "type": "string",
      "minLength": 1,
      "description": "How post-lock changes are approved and recorded without rewriting the original benchmark."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "statement",
        "priority",
        "weight",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "dimension": {
          "enum": [
            "business-outcome",
            "user-experience",
            "workflow",
            "data-portability",
            "integration",
            "control",
            "operability",
            "cost"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "target",
            "evidence_classes"
          ],
          "properties": {
            "method": {
              "enum": [
                "metric",
                "replay",
                "inspection",
                "query",
                "interview",
                "contract"
              ]
            },
            "target": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "evidence_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "structure",
                  "runtime",
                  "human-framing"
                ]
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
