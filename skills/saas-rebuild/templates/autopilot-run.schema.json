{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/autopilot-run.schema.json",
  "title": "Autopilot run status",
  "description": "Progress and role record for an autopilot run. It drives status.html and carries no evidence; findings stay in feature-inventory.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "updated_at",
    "access_level",
    "role",
    "gates",
    "steps",
    "now",
    "needs_you"
  ],
  "properties": {
    "schema_version": {
      "const": "0.12.0"
    },
    "mode": {
      "const": "autopilot"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "access_level": {
      "description": "What the signed-in account can do, as observed in the tenant. Decides admin or role-scoped behavior.",
      "enum": [
        "admin",
        "standard",
        "view-only",
        "unknown"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "can",
        "cannot"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "Where the role was observed, e.g. the settings page path."
        },
        "can": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cannot": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login",
        "data_boundary"
      ],
      "properties": {
        "login": {
          "enum": [
            "pending",
            "done"
          ]
        },
        "data_boundary": {
          "enum": [
            "pending",
            "approved"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "done",
              "skipped",
              "blocked"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "now": {
      "type": "string",
      "description": "One plain sentence: what the run is doing at this moment."
    },
    "needs_you": {
      "type": "array",
      "description": "Items parked for the person. They never stop the run; it continues with everything else.",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
