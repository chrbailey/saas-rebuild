{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/dependency-graph.schema.json",
  "title": "Typed teardown interaction graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "0.8.0" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "feature",
              "business-process",
              "entity",
              "script",
              "integration",
              "report"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "verdict": {
            "enum": ["KEEP", "SIMPLIFY", "DROP", "DEFER"]
          },
          "critical": { "type": "boolean" },
          "edges_unverified": { "type": "boolean" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "runtime_status",
          "evidence_ids"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": ["reads", "writes", "triggers", "joins-on", "exports-to", "supports"]
          },
          "runtime_status": {
            "enum": ["observed", "structural-only", "unknown"]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "algorithm_version"],
      "properties": {
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "algorithm_version": { "type": "string", "minLength": 1 },
        "sensitivity_parameters": { "type": "object" }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
