{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/model-annotations.schema.json",
  "title": "Auditable model perception annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "run_id",
    "target_kind",
    "target_id",
    "endpoint_id",
    "sent_data_classes",
    "question_id",
    "question_hash",
    "catalog_version",
    "model_returned",
    "answer",
    "effect",
    "resolution",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.10.0"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_kind": {
      "enum": [
        "feature",
        "citation",
        "graph-edge",
        "event-signature",
        "pair",
        "replay-residual",
        "interview-statement"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sent_data_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ]
      }
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "model_returned": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "probabilities",
        "confidence",
        "legend"
      ],
      "properties": {
        "type": {
          "enum": [
            "noul",
            "choice",
            "score"
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "probabilities": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "legend": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "calibrated_p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "threshold_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect": {
      "enum": [
        "flag",
        "veto",
        "reject",
        "prioritize",
        "suggest",
        "none"
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resolved_by",
        "resolved_at",
        "calllog_seq"
      ],
      "properties": {
        "status": {
          "enum": [
            "open",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "resolved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "calllog_seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
