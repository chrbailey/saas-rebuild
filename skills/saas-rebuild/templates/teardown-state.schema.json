{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/teardown-state.schema.json",
  "title": "Resumable SaaS teardown state",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": 5
          },
          "artifacts": {
            "required": [
              "feature_inventory",
              "pairs",
              "graph",
              "preservation_manifest",
              "success_profile",
              "evaluation_scorecard",
              "rebuild_plan"
            ]
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "teardown_id",
    "app",
    "started_at",
    "updated_at",
    "phase",
    "status",
    "data_boundary",
    "preflight",
    "artifacts",
    "extraction",
    "decisions",
    "action_log"
  ],
  "properties": {
    "schema_version": {
      "const": "0.10.0"
    },
    "teardown_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "methodology"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodology": {
          "enum": [
            "live-tenant",
            "document-based",
            "hybrid"
          ]
        }
      }
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "status": {
      "enum": [
        "in-progress",
        "blocked",
        "complete",
        "abandoned"
      ]
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_boundary",
        "connector_boundary",
        "artifact_root",
        "allowed_data_classes",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "model_boundary": {
          "enum": [
            "local",
            "self-hosted",
            "vendor-cloud",
            "mixed",
            "unknown"
          ]
        },
        "connector_boundary": {
          "enum": [
            "local",
            "self-hosted",
            "vendor-cloud",
            "mixed",
            "unknown"
          ]
        },
        "artifact_root": {
          "type": "string",
          "minLength": 1
        },
        "allowed_data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "notes": {
          "type": "string"
        },
        "source_classes": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        },
        "model_endpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "vendor",
              "endpoint",
              "boundary",
              "allowed_data_classes",
              "purposes",
              "zdr",
              "baa",
              "transfer_mechanism",
              "training_on_customer_data",
              "terms_version",
              "approved_by",
              "approved_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "vendor": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "const": "https://api.typesafe.ai/v1/systemone"
              },
              "boundary": {
                "enum": [
                  "local",
                  "self-hosted",
                  "vendor-cloud",
                  "mixed"
                ]
              },
              "allowed_data_classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "public",
                    "internal",
                    "confidential",
                    "restricted"
                  ]
                }
              },
              "purposes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "zdr": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "ref"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "not-in-force",
                      "in-force"
                    ]
                  },
                  "ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "baa": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "ref"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "not-in-force",
                      "in-force"
                    ]
                  },
                  "ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "transfer_mechanism": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "training_on_customer_data": {
                "enum": [
                  "unknown",
                  "yes",
                  "no"
                ]
              },
              "terms_version": {
                "type": "string",
                "minLength": 1
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "regulated_data": {
          "description": "Whether tenant data includes PHI or EU personal data. Model calls treat an absent declaration or 'unknown' as 'yes', so a BAA and a transfer mechanism are then required.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phi",
            "eu_personal_data"
          ],
          "properties": {
            "phi": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "eu_personal_data": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "preflight": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "owner"
        ],
        "properties": {
          "id": {
            "enum": [
              "authorization",
              "data-boundary",
              "vendor-terms",
              "volatile-logs",
              "contracts",
              "admin-access",
              "browser-automation",
              "model-vendor-review"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "blocked",
              "not-applicable"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_inventory",
        "pairs"
      ],
      "properties": {
        "feature_inventory": {
          "type": "string",
          "minLength": 1
        },
        "pairs": {
          "type": "string",
          "minLength": 1
        },
        "graph": {
          "type": "string",
          "minLength": 1
        },
        "preservation_manifest": {
          "type": "string",
          "minLength": 1
        },
        "success_profile": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_scorecard": {
          "type": "string",
          "minLength": 1
        },
        "model_annotations": {
          "type": "string",
          "minLength": 1
        },
        "rebuild_plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extraction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "route",
          "status"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "enum": [
              "api",
              "connector",
              "built-in-export",
              "report-csv",
              "scrape",
              "none"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "verified",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "made_at",
          "decision",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "made_at": {
            "$ref": "#/$defs/timestamp"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "annotation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "action_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "actor",
          "action",
          "target",
          "effect"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "read-only",
              "local-write",
              "remote-read",
              "remote-write",
              "unknown"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
