{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/skills/saas-rebuild/templates/pairs.schema.json",
  "title": "Teardown behavioral or judgment pair",
  "description": "One JSONL case. Dataset role and lineage group prevent training/evaluation leakage; label authority distinguishes observations from analyst opinions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "pair_type",
    "input",
    "output",
    "label_authority",
    "dataset_role",
    "split_group",
    "provenance",
    "sanitization_tier"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "pair_type": { "const": "replay" } },
        "required": ["pair_type"]
      },
      "then": {
        "required": ["replay_context"],
        "properties": {
          "label_authority": { "const": "system-of-record" }
        }
      }
    },
    {
      "if": {
        "properties": { "pair_type": { "const": "perception" } },
        "required": ["pair_type"]
      },
      "then": {
        "properties": {
          "label_authority": { "const": "observed-ui" }
        }
      }
    },
    {
      "if": {
        "properties": { "pair_type": { "const": "judgment" } },
        "required": ["pair_type"]
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "label_authority": { "const": "analyst" },
          "evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "pair_type": { "const": "design" } },
        "required": ["pair_type"]
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "label_authority": {
            "enum": ["analyst", "validated-design"]
          },
          "evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sanitization_tier": { "const": "sanitized-shareable" }
        },
        "required": ["sanitization_tier"]
      },
      "then": {
        "required": ["sanitization_review"],
        "properties": {
          "sanitization_review": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status", "reviewed_by", "reviewed_at"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "dataset_role": { "const": "holdout-eval" } },
        "required": ["dataset_role"]
      },
      "then": {
        "properties": {
          "label_authority": {
            "enum": ["system-of-record", "observed-ui", "validated-design"]
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "0.7.0" },
    "pair_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pair_type": {
      "enum": ["replay", "judgment", "perception", "design"]
    },
    "input": { "type": ["object", "string"] },
    "output": { "type": ["object", "string"] },
    "rationale": { "type": "string" },
    "label_authority": {
      "enum": [
        "system-of-record",
        "observed-ui",
        "analyst",
        "validated-design"
      ]
    },
    "dataset_role": {
      "enum": ["development", "regression", "holdout-eval"],
      "description": "holdout-eval lineages must never be used for training or design selection"
    },
    "split_group": {
      "type": "string",
      "minLength": 1,
      "description": "stable case/workflow/customer/period lineage used to prevent correlated leakage"
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "teardown_id",
        "phase",
        "created_at",
        "source_artifact_refs"
      ],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "teardown_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "phase": { "type": "integer", "minimum": 0, "maximum": 5 },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "source_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "replay_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "legacy_config_ref",
        "state_capture",
        "side_effect_free_verified"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])(?:T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
        },
        "legacy_config_ref": { "type": "string", "minLength": 1 },
        "state_capture": {
          "enum": ["captured", "self-contained", "unavailable"]
        },
        "side_effect_free_verified": { "const": true },
        "expected_divergence_ref": {
          "type": ["string", "null"]
        }
      }
    },
    "sanitization_tier": {
      "enum": ["raw-local-only", "sanitized-shareable", "synthetic"]
    },
    "sanitization_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "method": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_class",
        "plane",
        "claim",
        "source",
        "observed_at",
        "coverage",
        "confidence",
        "sensitivity",
        "supports"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidence_class": {
          "enum": ["structure", "runtime", "human-framing"]
        },
        "plane": {
          "enum": [
            "ui-walk",
            "config-census",
            "transactional",
            "master-data",
            "setup-census",
            "code-analysis",
            "telemetry",
            "integration-inventory",
            "export",
            "interview",
            "contract",
            "document"
          ]
        },
        "claim": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "observed_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "allOf": [
            {
              "if": {
                "properties": { "kind": { "const": "window-bounded" } },
                "required": ["kind"]
              },
              "then": { "required": ["start", "end"] }
            }
          ],
          "properties": {
            "kind": {
              "enum": [
                "all-time",
                "window-bounded",
                "point-in-time",
                "not-applicable"
              ]
            },
            "start": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$" },
            "end": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$" },
            "notes": { "type": "string" }
          }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sensitivity": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["usage", "criticality", "verdict", "dependency"]
          }
        },
        "source_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "derived_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
