{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaaS teardown feature entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nav_path",
    "name",
    "kind"
  ],
  "allOf": [
    {
      "if": { "required": ["verdict"] },
      "then": {
        "required": ["evidence"],
        "properties": { "evidence": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "usage": { "not": { "const": "unknown" } } },
        "required": ["usage"]
      },
      "then": {
        "required": ["evidence"],
        "properties": { "evidence": { "minItems": 1 } }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "kebab-case, stable across runs, e.g. invoices-aging-report"
    },
    "nav_path": {
      "type": "string",
      "description": "UI breadcrumb, e.g. Reports > Billing > Aging"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "screen",
        "form",
        "report",
        "setting",
        "integration",
        "automation"
      ]
    },
    "data_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_signals": {
      "type": "object",
      "description": "usage evidence seen in the UI, captured during the walk",
      "additionalProperties": false,
      "properties": {
        "record_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "newest_record": {
          "type": [
            "string",
            "null"
          ]
        },
        "oldest_record": {
          "type": [
            "string",
            "null"
          ]
        },
        "empty_state": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "usage": {
      "enum": [
        "daily",
        "weekly",
        "rare",
        "never",
        "workaround-external",
        "workaround-internal",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "description": "typed citations backing usage and verdict; one item per independent signal — a verdict or a non-unknown usage requires at least one",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plane",
          "claim",
          "source"
        ],
        "properties": {
          "plane": {
            "enum": [
              "ui-walk",
              "config-census",
              "transactional",
              "master-data",
              "setup-census",
              "code-analysis",
              "telemetry",
              "integration-inventory",
              "export",
              "interview",
              "contract",
              "document"
            ],
            "description": "which evidence stream produced the signal; see SKILL.md Phase 3 for the plane-to-class mapping the join rule uses"
          },
          "claim": {
            "type": "string",
            "description": "the specific assertion this citation supports, one sentence"
          },
          "source": {
            "type": "string",
            "description": "where it was seen, precisely enough to re-run: table/report/log window/doc, no record contents"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}",
            "description": "ISO date the signal was observed; null if not recorded"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "how directly the signal supports the claim"
          },
          "derived_from": {
            "type": [
              "string",
              "null"
            ],
            "description": "id or source of another citation this one is derived from; two citations sharing a derivation chain count as ONE signal for corroboration"
          }
        }
      }
    },
    "criticality": {
      "enum": [
        "critical",
        "important",
        "nice-to-have",
        "none"
      ]
    },
    "replaceability": {
      "enum": [
        "trivial",
        "moderate",
        "hard"
      ]
    },
    "verdict": {
      "enum": [
        "KEEP",
        "SIMPLIFY",
        "DROP",
        "DEFER"
      ]
    },
    "why": {
      "type": "string"
    },
    "unused_reason": {
      "enum": [
        "never-needed",
        "too-complex",
        "duplicate",
        "wrong-fit",
        "configured-never-enabled",
        "unknown",
        null
      ]
    }
  }
}
