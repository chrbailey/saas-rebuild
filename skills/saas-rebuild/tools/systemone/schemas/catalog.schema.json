{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/systemone/schemas/catalog-systemone-1.json",
  "title": "SaaS Rebuild System One question catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "purpose", "questions"],
  "properties": {
    "schema_version": {"const": "systemone/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "questions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "authority", "consumer", "gold"],
        "properties": {
          "question": {
            "type": "object",
            "required": ["type", "instructions"],
            "properties": {
              "type": {"enum": ["choice", "score", "noul"]},
              "instructions": {},
              "criteria": {}
            }
          },
          "authority": {"enum": ["veto", "flag", "reject", "prioritize", "suggest"]},
          "trigger": {
            "description": "Choice options the authority acts on. A choice question without a trigger can only suggest; it never flags, vetoes, rejects, or prioritizes.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "compare": {
            "description": "Choice options that contradict a declared field of the target. The runner looks up the target's value for `against` and acts on the probability of the options listed for it. A value that is absent, or not listed, gives no signal. An empty list means no answer can contradict that value.",
            "type": "object",
            "additionalProperties": false,
            "required": ["against", "contradicts"],
            "properties": {
              "against": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "contradicts": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "candidate_slots": {
            "description": "The question picks one of the candidate-N options, each standing for a target code supplied in slot order. It can only suggest, and only a slot that was actually offered.",
            "const": true
          },
          "consumer": {"type": "string", "minLength": 1},
          "gold": {"type": ["string", "null"]}
        },
        "not": {"required": ["trigger", "compare"]},
        "if": {"required": ["candidate_slots"]},
        "then": {
          "properties": {
            "authority": {"const": "suggest"},
            "question": {"properties": {"type": {"const": "choice"}}}
          },
          "not": {"anyOf": [{"required": ["trigger"]}, {"required": ["compare"]}]}
        }
      }
    }
  }
}
