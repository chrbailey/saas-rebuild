{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrbailey/saas-rebuild/systemone/schemas/catalog-systemone-1.json",
  "title": "SaaS Rebuild System One question catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "purpose", "questions"],
  "properties": {
    "schema_version": {"const": "systemone/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "questions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "authority", "consumer", "gold"],
        "properties": {
          "question": {
            "type": "object",
            "required": ["type", "instructions"],
            "properties": {
              "type": {"enum": ["choice", "score", "noul"]},
              "instructions": {},
              "criteria": {}
            }
          },
          "authority": {"enum": ["veto", "flag", "reject", "prioritize", "suggest"]},
          "consumer": {"type": "string", "minLength": 1},
          "gold": {"type": ["string", "null"]}
        }
      }
    }
  }
}
