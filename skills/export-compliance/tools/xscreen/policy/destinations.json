{
  "$comment": [
    "OPERATOR-MAINTAINED POLICY FILE. This is not law and it is not shipped as",
    "a legal authority. Country restrictions change by Federal Register notice,",
    "sometimes weekly. Every rule derived from this file emits a warning that",
    "cites `as_of` so no screening result can quietly rely on stale policy.",
    "Before production use, confirm each entry against the citations in",
    "`verify_against` and set `verified_by` / `verified_on`."
  ],
  "as_of": "2026-01-01",
  "verified_by": "",
  "verified_on": "",
  "verify_against": {
    "ear_country_groups": "15 CFR Part 740, Supplement No. 1",
    "ear_embargoes": "15 CFR Part 746",
    "itar_proscribed": "22 CFR 126.1",
    "ofac_programs": "https://ofac.treasury.gov/sanctions-programs-and-country-information"
  },
  "tiers": {
    "comprehensive": "Broad prohibition on exports, reexports and transfers absent a licence or an applicable authorization. Treat any transaction as licence-required until proven otherwise.",
    "extensive": "Large, item- and end-user-specific restrictions that fall short of a comprehensive embargo. Licence analysis is mandatory but a general prohibition should not be assumed.",
    "itar_proscribed": "United States policy of denial for defense articles and defense services. Applies to ITAR-controlled items regardless of the EAR analysis.",
    "targeted": "Restrictions aimed at named persons, sectors or a government rather than the destination as a whole. List screening carries most of the weight here."
  },
